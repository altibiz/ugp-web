@*
    Homepage template. Selected by HomepageContentDisplayDriver for the content item set as the
    site homepage. The page's FlowPart widgets (stats, mission quote, carousel, pledge form,
    partner galleries...) are still edited in the admin; this view only groups them into
    full-width sections and adds a hero, a "Novosti" section and a closing call to action.
*@
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Html
@using OrchardCore.ContentManagement.Routing
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Display
@using OrchardCore.ContentManagement.Records
@using OrchardCore.DisplayManagement.ModelBinding
@using OrchardCore.Flows.Models
@using OrchardCore.Lists.Indexes
@using OrchardCore.Modules
@using OrchardCore.Mvc.Utilities
@using YesSql
@inject IContentItemDisplayManager ContentItemDisplayManager
@inject IUpdateModelAccessor UpdateModelAccessor
@inject IAutorouteEntries AutorouteEntries
@inject YesSql.ISession Session
@inject ILocalClock LocalClock

@functions {
    private const string NewsPath = "/novosti";

    // Widgets are grouped into sections by kind; consecutive widgets of the same kind share a section.
    private static string KindOf(ContentItem widget)
    {
        switch (widget.ContentType)
        {
            case "RawHtml":
                // The stats block is a RawHtml widget built from .top-features columns.
                return (Str(Data(widget), "RawHtml", "Content", "Html") ?? string.Empty).Contains("top-features") ? "stats" : "other";
            case "Blockquote":
                return "mission";
            case "Carousel":
            case "Paragraph":
            case "Image":
            case "PledgeForm":
                return "support";
            case "Gallery":
                return "logos";
            case "RecentNews":
                return "news";
            default:
                return "other";
        }
    }

    // Content parts/fields as they appear in the item's JSON (same shape as in recipes).
    private static JsonNode Data(ContentItem item) => JsonSerializer.SerializeToNode(item);

    private static string Str(JsonNode node, params string[] path)
    {
        foreach (var key in path)
        {
            node = node is JsonObject obj ? obj[key] : null;
        }
        return node is JsonValue value && value.TryGetValue<string>(out var text) ? text : null;
    }

    private static string FirstPath(JsonNode data, string part, string field)
        => data?[part]?[field]?["Paths"] is JsonArray paths && paths.Count > 0 && paths[0] is JsonValue v && v.TryGetValue<string>(out var p) ? p : null;

    private static string Excerpt(JsonNode data, int max = 170)
    {
        var source = Str(data, "MarkdownBodyPart", "Markdown")
            ?? Str(data, "HtmlBodyPart", "Html")
            ?? string.Empty;

        var text = Regex.Replace(source, "<[^>]+>", " ");                // html tags
        text = Regex.Replace(text, @"!\[[^\]]*\]\([^)]*\)", " ");        // markdown images
        text = Regex.Replace(text, @"\[([^\]]*)\]\([^)]*\)", "$1");      // markdown links
        text = Regex.Replace(text, @"[#>*_`~|]+", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = Regex.Replace(text, @"\s+", " ").Trim();

        if (text.Length <= max)
        {
            return text;
        }

        var cut = text.LastIndexOf(' ', max);
        return text.Substring(0, cut > 0 ? cut : max).TrimEnd(',', '.', ';', ':', '-') + "…";
    }

    private sealed class Group
    {
        public string Kind { get; init; }
        public List<ContentItem> Widgets { get; } = new();
    }
}

@{
    ContentItem homeItem = Model.ContentItem;
    var widgets = homeItem.As<FlowPart>()?.Widgets ?? new List<ContentItem>();

    var groups = new List<Group>();
    foreach (var widget in widgets)
    {
        var kind = KindOf(widget);
        if (groups.Count == 0 || groups[^1].Kind != kind || kind == "other")
        {
            groups.Add(new Group { Kind = kind });
        }
        groups[^1].Widgets.Add(widget);
    }

    // Stats are shown inside the hero, everything else as page sections.
    var stats = groups.FirstOrDefault(g => g.Kind == "stats");
    if (stats != null)
    {
        groups.Remove(stats);
    }

    // Recent news from /novosti as cards. A RecentNews widget in the flow only marks where
    // they go; without one they follow the intro (stats + mission).
    var newsPosts = new List<ContentItem>();
    var (found, entry) = await AutorouteEntries.TryGetEntryByPathAsync(NewsPath);
    if (found)
    {
        newsPosts = (await Session.Query<ContentItem>()
            .With<ContainedPartIndex>(x => x.ListContentItemId == entry.ContentItemId)
            .With<ContentItemIndex>(x => x.Published)
            .OrderByDescending(x => x.CreatedUtc)
            .Take(3)
            .ListAsync()).ToList();
    }

    var newsAt = groups.FindIndex(g => g.Kind == "news");
    groups.RemoveAll(g => g.Kind == "news");
    if (newsPosts.Count > 0)
    {
        if (newsAt < 0)
        {
            newsAt = groups.FindIndex(g => g.Kind != "mission");
        }
        groups.Insert(newsAt < 0 ? groups.Count : Math.Min(newsAt, groups.Count), new Group { Kind = "news-auto" });
    }

    var hasSupport = groups.Any(g => g.Kind == "support");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var updater = UpdateModelAccessor.ModelUpdater;

    async Task<IHtmlContent> RenderWidget(ContentItem widget)
    {
        var shape = await ContentItemDisplayManager.BuildDisplayAsync(widget, updater, "Detail");
        shape.Classes.Add("widget");
        shape.Classes.Add("widget-" + widget.ContentType.HtmlClassify());
        return await DisplayAsync(shape);
    }
}

<style asp-name="ugptheme-home"></style>

<header class="home-hero">
    <div class="home-hero__bg" style="background-image: url('@Url.Content("~/UgpTheme/assets/img/home-bg.jpg")')"></div>
    <div class="container px-4 px-lg-5 home-hero__inner">
        <p class="home-eyebrow home-eyebrow--light">Udruga mikro, malih i srednjih poduzetnika</p>
        <h1 class="home-hero__title">@homeItem.DisplayText</h1>
        <p class="home-hero__lead">
            Okupljamo poduzetnike, obrtnike, samozaposlene i sve zaposlene u privatnom sektoru.
            Konkretnim prijedlozima mjera i reformi gradimo zdrave temelje za Hrvatsku 2.0.
        </p>
        <div class="home-hero__actions">
            @if (isAuthenticated)
            {
                <a class="home-btn home-btn--primary" href="~/members/portal">Moj portal</a>
            }
            else
            {
                <a class="home-btn home-btn--primary" href="~/register">Učlani se</a>
            }
            <a class="home-btn home-btn--ghost" href="@(hasSupport ? "#podrzi" : Url.Content("~/members/donate"))">Podrži nas</a>
        </div>
    </div>

    @if (stats != null)
    {
        <div class="container px-4 px-lg-5 home-stats">
            @foreach (var widget in stats.Widgets)
            {
                @await RenderWidget(widget)
            }
        </div>
    }
</header>

@foreach (var group in groups)
{
    if (group.Kind == "mission")
    {
            <section class="home-section home-mission">
                <div class="container px-4 px-lg-5">
                    <div class="home-mission__grid">
                        <div class="home-mission__intro">
                            <p class="home-eyebrow">Tko smo</p>
                            <h2 class="home-title">Glas onih koji stvaraju vrijednost</h2>
                            <p class="home-muted">Neovisni smo i nemamo političkih ambicija. Ne povezujemo se ni s jednom političkom opcijom.</p>
                            <a class="home-link" href="~/o-nama">Više o udruzi <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                        </div>
                        <div class="home-mission__quote">
                            @foreach (var widget in group.Widgets)
                            {
                                @await RenderWidget(widget)
                            }
                        </div>
                    </div>
                </div>
            </section>
    }
    else if (group.Kind == "news-auto")
    {
            <section class="home-section home-news">
                <div class="container px-4 px-lg-5">
                    <div class="home-section__head">
                        <div>
                            <p class="home-eyebrow">Novosti</p>
                            <h2 class="home-title">Najnovije iz udruge</h2>
                        </div>
                        <a class="home-link" href="@Url.Content("~" + NewsPath)">Sve novosti <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                    <div class="home-news__grid">
                        @foreach (var post in newsPosts)
                        {
                            var data = Data(post);
                            var href = Url.Content("~/" + (Str(data, "AutoroutePart", "Path") ?? string.Empty).TrimStart('/'));
                            var imagePath = FirstPath(data, "BlogPost", "Image");
                            var subtitle = Str(data, "BlogPost", "Subtitle", "Text");
                            var excerpt = string.IsNullOrWhiteSpace(subtitle) ? Excerpt(data) : subtitle;
                            var created = post.CreatedUtc.HasValue ? await LocalClock.ConvertToLocalAsync(post.CreatedUtc.Value) : (DateTimeOffset?)null;

                            <article class="home-news__card">
                                <a class="home-news__media" href="@href" tabindex="-1" aria-hidden="true">
                                    @if (!string.IsNullOrEmpty(imagePath))
                                    {
                                        <img src="@Orchard.AssetUrl(imagePath)" alt="" loading="lazy">
                                    }
                                    else
                                    {
                                        <span class="home-news__placeholder"><i class="far fa-newspaper"></i></span>
                                    }
                                </a>
                                <div class="home-news__body">
                                    @if (created.HasValue)
                                    {
                                        <time class="home-news__date" datetime="@created.Value.ToString("yyyy-MM-dd")">@created.Value.ToString("dd.MM.yyyy.")</time>
                                    }
                                    <h3 class="home-news__title"><a href="@href">@post.DisplayText</a></h3>
                                    @if (!string.IsNullOrWhiteSpace(excerpt))
                                    {
                                        <p class="home-news__excerpt">@excerpt</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </section>
    }
    else if (group.Kind == "support")
    {
            var forms = group.Widgets.Where(w => w.ContentType == "PledgeForm").ToList();
            var story = group.Widgets.Where(w => w.ContentType != "PledgeForm").ToList();
            <section class="home-section home-support" id="podrzi">
                <div class="container px-4 px-lg-5">
                    <div class="home-support__head">
                        <p class="home-eyebrow">Podrži nas</p>
                        <h2 class="home-title">Uloži u budućnost hrvatskog poduzetništva</h2>
                    </div>
                    <div class="home-support__grid @(forms.Count == 0 || story.Count == 0 ? "home-support__grid--single" : null)">
                        @if (story.Count > 0)
                        {
                            <div class="home-support__story">
                                @foreach (var widget in story)
                                {
                                    @await RenderWidget(widget)
                                }
                            </div>
                        }
                        @if (forms.Count > 0)
                        {
                            <div class="home-support__form">
                                <div class="home-card">
                                    <h3 class="home-card__title"><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> Doniraj</h3>
                                    <p class="home-muted small">Odaberite iznos i preuzmite podatke za uplatu s 2D kodom.</p>
                                    @foreach (var widget in forms)
                                    {
                                        @await RenderWidget(widget)
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
    }
    else if (group.Kind == "logos")
    {
            <section class="home-section home-logos">
                <div class="container px-4 px-lg-5">
                    @foreach (var widget in group.Widgets)
                    {
                        <div class="home-logos__group">
                            @await RenderWidget(widget)
                        </div>
                    }
                </div>
            </section>
    }
    else
    {
            <section class="home-section home-other">
                <div class="container px-4 px-lg-5 home-narrow">
                    @foreach (var widget in group.Widgets)
                    {
                        @await RenderWidget(widget)
                    }
                </div>
            </section>
    }
}

<section class="home-cta">
    <div class="container px-4 px-lg-5">
        <div class="home-cta__inner">
            <div>
                <h2 class="home-cta__title">Budi dio glasa koji pokreće promjene</h2>
                <p class="home-cta__text">Što nas je više, to se nas bolje čuje. Pridruži se tisućama poduzetnika koji već mijenjaju pravila igre.</p>
            </div>
            <div class="home-cta__actions">
                @if (isAuthenticated)
                {
                    <a class="home-btn home-btn--primary" href="~/members/portal">Moj portal</a>
                }
                else
                {
                    <a class="home-btn home-btn--primary" href="~/register">Učlani se</a>
                }
            </div>
        </div>
    </div>
</section>
