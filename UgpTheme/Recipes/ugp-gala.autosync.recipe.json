          "HtmlBodyPart": {
            "Html": "<style>\n    /* Gala palette: deep teal + gold, matching the poster. Overrides the shared LandingPage tokens for this page only. */\n    :root {\n        --lp-ink: #072b2d;\n        --lp-ink-2: #0b4245;\n        --lp-teal: #9a7430;\n        --lp-teal-light: #e8cc84;\n        --lp-coral: #d4af5a;\n        --lp-paper: #f8f5ee;\n        --lp-line: #e9e1cf;\n    }\n    .lp .lp-btn-primary { background: linear-gradient(135deg, #e8cc84, #c49a45); color: #072b2d; }\n    .lp .lp-btn-primary:hover { background: linear-gradient(135deg, #f0d898, #d4af5a); color: #072b2d; }\n    .lp-hero {\n        background:\n            radial-gradient(900px 500px at 85% -10%, rgba(232, 204, 132, .22), transparent 60%),\n            radial-gradient(700px 400px at -10% 110%, rgba(22, 110, 112, .55), transparent 60%),\n            linear-gradient(160deg, #072b2d 0%, #0b4245 100%);\n    }\n    .lp-hero::before {\n        background-image: radial-gradient(rgba(232, 204, 132, .35) 1px, transparent 1.5px);\n        background-size: 34px 34px;\n    }\n    .lp-hero-media img { box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .7), 0 0 0 1px rgba(232, 204, 132, .35); }\n    .lp-notice { background: rgba(232, 204, 132, .14); }\n    .lp-card:hover { box-shadow: 0 14px 30px -20px rgba(154, 116, 48, .7); }\n    .lp-note { background: rgba(212, 175, 90, .14); }\n    .lp-tag { background: rgba(154, 116, 48, .12); }\n    .lp-tag--panel { background: rgba(11, 66, 69, .1); color: #0b4245; }\n    .lp-quote { border-left-color: var(--lp-coral); }\n    .lp-cta { background: radial-gradient(700px 300px at 50% 0%, rgba(232, 204, 132, .25), transparent 70%), var(--lp-ink-2); }\n\n    .gala-prices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }\n    .gala-price {\n        padding: 28px; background: #fff; border: 1px solid var(--lp-line); border-radius: var(--lp-radius);\n        display: flex; flex-direction: column; gap: 6px;\n    }\n    .gala-price--main { border-color: var(--lp-teal); box-shadow: 0 14px 30px -22px rgba(154, 116, 48, .8); }\n    .gala-price strong { font-size: 40px; font-weight: 800; line-height: 1.1; color: var(--lp-ink); }\n    .gala-price span { color: var(--lp-muted); font-size: 16px; }\n    .gala-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 32px; margin: 32px 0 0; }\n    .gala-facts div { padding: 18px 0; border-top: 1px solid var(--lp-line); }\n    .gala-facts dt { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--lp-teal); margin-bottom: 4px; }\n    .gala-facts dd { margin: 0; font-weight: 700; color: var(--lp-ink); }\n    .gala-sign { margin-top: 28px; font-style: italic; color: var(--lp-muted); }\n    .lp .lp-section h3.gala-program-title { margin: 56px 0 0; font-size: 24px; }\n    .gala-program-title + .lp-agenda { margin-top: 20px; }\n    .lp-agenda time { color: var(--lp-teal); }\n    .gala-signup { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; margin-top: 32px; }\n    .gala-steps { margin: 24px 0; padding: 0; list-style: none; counter-reset: gala-step; }\n    .gala-steps li { position: relative; padding: 6px 0 6px 46px; counter-increment: gala-step; font-weight: 600; color: var(--lp-ink); }\n    .gala-steps li::before {\n        content: counter(gala-step); position: absolute; left: 0; top: 4px; width: 32px; height: 32px; border-radius: 50%;\n        display: grid; place-items: center; background: var(--lp-ink-2); color: var(--lp-teal-light); font-weight: 800; font-size: 15px;\n    }\n    .gala-signup-note { color: var(--lp-muted); font-size: 15px; }\n\n    /* The payment form (PledgeFormEmbed shape). This layout has no Bootstrap, so the form controls are styled here. */\n    .gala-form form {\n        margin: 0; padding: 28px; background: #fff; border: 1px solid var(--lp-line); border-top: 4px solid var(--lp-coral);\n        border-radius: var(--lp-radius); box-shadow: 0 24px 50px -34px rgba(7, 43, 45, .55);\n    }\n    .gala-form #personSelector { padding-bottom: 0; border-bottom: 0; border-radius: var(--lp-radius) var(--lp-radius) 0 0; box-shadow: none; }\n    .gala-form #personSelector + form { padding-top: 8px; border-top: 0; border-radius: 0 0 var(--lp-radius) var(--lp-radius); }\n    .gala-form .content-part-wrapper, .gala-form .field-wrapper, .gala-form .form-floating { margin: 0 0 16px; }\n    .gala-form .content-part-wrapper > :last-child { margin-bottom: 0; }\n    .gala-form .form-floating { display: flex; flex-direction: column-reverse; }\n    .gala-form label { display: block; margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--lp-ink); }\n    .gala-form .form-control, .gala-form .form-select {\n        display: block; width: 100%; min-height: 46px; padding: 10px 14px; border: 1px solid #d9d2c0; border-radius: 10px;\n        background: #fff; color: var(--lp-text); font: inherit; font-size: 16px;\n    }\n    .gala-form .form-control:focus, .gala-form .form-select:focus { outline: 0; border-color: var(--lp-teal); box-shadow: 0 0 0 3px rgba(212, 175, 90, .3); }\n    .gala-form ::placeholder { color: transparent; }\n    .gala-form .input-group { display: flex; flex-wrap: wrap; }\n    .gala-form .input-group-text { display: flex; align-items: center; padding: 0 14px; border: 1px solid #d9d2c0; border-right: 0; border-radius: 10px 0 0 10px; background: var(--lp-paper); color: var(--lp-muted); }\n    .gala-form .input-group .form-control { flex: 1 1 0; width: auto; border-radius: 0 10px 10px 0; }\n    .gala-form .input-group .field-validation-valid, .gala-form .input-group .field-validation-error { flex-basis: 100%; }\n    .gala-form .field-validation-error, .gala-form .text-danger { color: #b3261e; font-size: 14px; }\n    .gala-form .multiselect { color: var(--lp-text); font-size: 16px; }\n    .gala-form .multiselect__tags { min-height: 46px; padding-top: 10px; border-color: #d9d2c0; border-radius: 10px; }\n    .gala-form .multiselect__select { height: 44px; }\n    .gala-form .multiselect__single, .gala-form .multiselect__input { font-size: 16px; }\n    .gala-form .multiselect__input::placeholder, .gala-form .multiselect__placeholder { color: var(--lp-muted); }\n    .gala-form .multiselect__option--highlight { background: var(--lp-ink-2); color: #fff; }\n    .gala-form .multiselect__option--selected.multiselect__option--highlight { background: var(--lp-teal); color: #fff; }\n    /* The shared field is labelled \"Količina\"; here it is the choice of ticket. */\n    .gala-form .form-tags + label { font-size: 0; }\n    .gala-form .form-tags + label::after { content: \"Opcija plaćanja\"; font-size: 13px; }\n    .gala-form .btn.publish {\n        display: flex; justify-content: center; width: 100%; margin-top: 8px; padding: 14px 22px; border: 0; border-radius: 999px; cursor: pointer;\n        background: linear-gradient(135deg, #e8cc84, #c49a45); color: #072b2d; font: inherit; font-weight: 700; font-size: 16px;\n    }\n    .gala-form .btn.publish:hover { background: linear-gradient(135deg, #f0d898, #d4af5a); }\n    @media (max-width: 860px) {\n        .gala-prices, .gala-facts, .gala-signup { grid-template-columns: 1fr; }\n        .gala-signup { gap: 28px; }\n    }\n</style>\n\n<section class=\"lp-section\" id=\"o-veceri\" data-nav=\"O večeri\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Večer zajedništva, uspjeha i novih poduzetničkih prilika</span>\n        <h2>Slavimo poduzetnički duh i ljude koji stvaraju vrijednost</h2>\n        <p class=\"lp-lead\">Udruga Glas poduzetnika s veseljem najavljuje <strong>6. UGP GALA – Božićnu donatorsku večer</strong>, koja će se održati <strong>1. prosinca 2026.</strong> godine u <strong><a href=\"https://www.google.com/maps/search/Hotel%20International%20Miramarska%2024%20Zagreb\" target=\"_blank\" rel=\"noopener\">Hotelu International</a></strong> u Zagrebu, s početkom okupljanja u 18:30 sati.</p>\n        <div class=\"lp-cols\">\n            <div>\n                <p>Tradicionalna GALA večer okuplja poduzetnike, obrtnike, predstavnike javnog sektora, poslovne partnere, medije i prijatelje poduzetništva kako bismo zajedno obilježili još jednu godinu izazova, postignuća i zajedničkog djelovanja.</p>\n                <p>U svečanom ozračju osvrnut ćemo se na aktivnosti i rezultate Udruge Glas poduzetnika tijekom 2026. godine, zahvaliti svima koji su pridonijeli našem radu te otvoriti razgovor o izazovima i prilikama koje nas očekuju u 2027. godini.</p>\n            </div>\n            <blockquote class=\"lp-quote\">Ovo je večer u kojoj slavimo poduzetnički duh, upornost, hrabrost i ljude koji svojim radom svakodnevno stvaraju vrijednost za hrvatsko gospodarstvo.</blockquote>\n        </div>\n    </div>\n</section>\n\n<section class=\"lp-section lp-section--alt\" id=\"prijavnica\" data-nav=\"Prijava\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Prijava</span>\n        <h2>Potvrdite dolazak</h2>\n        <div class=\"gala-signup\">\n            <div>\n                <p class=\"lp-lead\">Ispunite obrazac, odaberite opciju plaćanja i odmah dobivate podatke za uplatu kotizacije.</p>\n                <ol class=\"gala-steps\">\n                    <li>Upišite podatke i odaberite opciju plaćanja</li>\n                    <li>Dobivate podatke za uplatu i 2D kod</li>\n                    <li>Skenirajte kod u mobilnom bankarstvu – i gotovo</li>\n                </ol>\n                <p class=\"gala-signup-note\">UGPartner cijena vrijedi za UGP partnere koji plaćaju godišnju članarinu. Za zakup stola za 5 ili više osoba cijena je 100 EUR po osobi.</p>\n            </div>\n            <div class=\"gala-form\">\n                {% shape \"PledgeFormEmbed\", pledge_type: \"PledgeExtended\", taxonomy_id: \"4t8k2n6pw3x9m5q7c1zhb0ydre\" %}\n            </div>\n        </div>\n    </div>\n</section>\n\n<section class=\"lp-section\" id=\"program\" data-nav=\"Program\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Zajedno za snažnije poduzetništvo</span>\n        <h2>Što vas očekuje</h2>\n        <div class=\"lp-cards\">\n            <article class=\"lp-card\">\n                <h3>Tri panela</h3>\n                <p>Razgovor o važnosti poduzetničkog glasa u javnom prostoru, poslovnim rizicima i izazovima te ekonomskim i digitalnim perspektivama u nadolazećoj godini.</p>\n            </article>\n            <article class=\"lp-card\">\n                <h3>Godišnja UGP priznanja</h3>\n                <p>Poseban dio večeri posvećen je dodjeli priznanja onima koji su svojim radom i doprinosom ostavili trag u poduzetničkoj zajednici.</p>\n            </article>\n            <article class=\"lp-card\">\n                <h3>Svečana večera</h3>\n                <p>Nakon službenog programa slijedi svečana večera i druženje u opuštenom blagdanskom ozračju.</p>\n            </article>\n            <article class=\"lp-card\">\n                <h3>Nova partnerstva</h3>\n                <p>Prilika da učvrstimo postojeća partnerstva, stvorimo nova poznanstva i zajednički postavimo temelje za još snažniju 2027. godinu.</p>\n            </article>\n        </div>\n        <h3 class=\"gala-program-title\">Program večeri</h3>\n        <ol class=\"lp-agenda\">\n            <li><time>18:30 – 19:00</time><div><h3>Okupljanje uzvanika</h3><p>Piće dobrodošlice, fotografiranje i poslovno povezivanje.</p></div></li>\n            <li><time>19:00 – 19:15</time><div><h3>Službeno otvorenje</h3><p>Uvodna obraćanja, pregled postignuća i planova UGP-a te kratki film o radu Udruge.</p></div></li>\n            <li><time>19:15 – 19:35</time><div><span class=\"lp-tag lp-tag--panel\">Panel 1</span><h3>Neka se vaš glas čuje: od stručnosti do vidljivosti i utjecaja</h3></div></li>\n            <li><time>19:35 – 19:55</time><div><span class=\"lp-tag lp-tag--panel\">Panel 2</span><h3>Preživjeti 2027.: poduzetnički „priručnik“ za turbulencije</h3></div></li>\n            <li><time>19:55 – 20:20</time><div><span class=\"lp-tag lp-tag--panel\">Panel 3</span><h3>Gdje su prilike? Do kapitala, potpora i digitalnog skoka za poduzetnike</h3></div></li>\n            <li><time>20:20 – 20:30</time><div><h3>Svečana dodjela UGP nagrada 2026.</h3></div></li>\n            <li><time>20:30 – 20:35</time><div><h3>Završne zahvale</h3><p>Zahvala uzvanicima, panelistima, partnerima i sponzorima te najava svečane večere.</p></div></li>\n            <li><time>Od 20:35</time><div><h3>Svečana večera</h3><p>Svečana večera uz zabavni program u blagdanskom ozračju.</p></div></li>\n            <li><time>Nakon večere</time><div><h3>Druženje i poslovno povezivanje</h3><p>Neformalno druženje uzvanika i nastavak večeri.</p></div></li>\n        </ol>\n    </div>\n</section>\n\n<section class=\"lp-section lp-section--alt\" id=\"kotizacija\" data-nav=\"Kotizacija\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Sudjelovanje</span>\n        <h2>Cijena sudjelovanja</h2>\n        <div class=\"gala-prices\">\n            <div class=\"gala-price gala-price--main\"><strong>130 EUR</strong><span>Cijena sudjelovanja</span></div>\n            <div class=\"gala-price\"><strong>110 EUR</strong><span>Posebna cijena za UGP partnere koji plaćaju godišnju članarinu</span></div>\n            <div class=\"gala-price\"><strong>100 EUR</strong><span>Za zakup stola za 5 ili više osoba</span></div>\n        </div>\n        <div class=\"lp-note\">\n            <p style=\"margin:0 0 .5em\"><strong>Molimo potvrdite dolazak do 27. studenoga 2026. do 12:00 sati.</strong></p>\n            <p style=\"margin:0\">Prijavite se putem <a href=\"#prijavnica\">obrasca za prijavu</a> – podatke za uplatu kotizacije i 2D kod dobivate odmah.</p>\n        </div>\n    </div>\n</section>\n\n<section class=\"lp-section\" id=\"donacije\" data-nav=\"Donacije\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Božićna donatorska večer</span>\n        <h2>Podržite rad udruge</h2>\n        <p class=\"lp-lead\">Donacije za GALA večer možete uplatiti putem poveznice, čime ujedno i podržavate rad udruge.</p>\n        <p style=\"margin-top:24px\"><a class=\"lp-btn lp-btn-primary\" href=\"/doniraj\">Doniraj <i class=\"fas fa-arrow-right\"></i></a></p>\n    </div>\n</section>\n\n<section class=\"lp-section lp-section--alt\" id=\"lokacija\" data-nav=\"Lokacija\">\n    <div class=\"lp-wrap\">\n        <span class=\"lp-kicker\">Gdje i kada</span>\n        <h2>Hotel International, Zagreb</h2>\n        <dl class=\"gala-facts\">\n            <div><dt>Datum</dt><dd>1. prosinca 2026.</dd></div>\n            <div><dt>Lokacija</dt><dd><a href=\"https://www.google.com/maps/search/Hotel%20International%20Miramarska%2024%20Zagreb\" target=\"_blank\" rel=\"noopener\">Hotel International, Miramarska 24, Zagreb</a></dd></div>\n            <div><dt>Okupljanje</dt><dd>od 18:30 sati</dd></div>\n            <div><dt>Početak službenog programa</dt><dd>19:00 sati</dd></div>\n        </dl>\n        <p class=\"gala-sign\">Veselimo se vašem dolasku!<br>Udruga Glas poduzetnika</p>\n    </div>\n</section>\n"
          }
        }
