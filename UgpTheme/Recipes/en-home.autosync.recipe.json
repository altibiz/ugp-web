              {
                "ContentItemId": "4ugphomeenhero000000000000",
                "ContentType": "RawHtml",
                "DisplayText": "",
                "Latest": false,
                "Published": false,
                "RawHtml": {
                  "Content": {
                    "Html": "<header class=\"ugp-home ugp-hero\">\n    <div class=\"container px-4 px-lg-5 ugp-hero__inner\">\n        <p class=\"ugp-eyebrow\">Association of micro, small and medium-sized entrepreneurs</p>\n        <h1 class=\"ugp-hero__title\">Voice of Entrepreneurs</h1>\n        <p class=\"ugp-hero__lead\">We fight for lower levies, clear rules and a state that serves those who create value.</p>\n        <div class=\"ugp-hero__actions\">\n            <a class=\"ugp-btn ugp-btn--primary\" href=\"/register\">Become a member</a>\n            <a class=\"ugp-btn ugp-btn--ghost\" href=\"#what-we-do\">What we do</a>\n        </div>\n    </div>\n    <div class=\"container px-4 px-lg-5 ugp-stats\">\n        <div class=\"ugp-stats__grid\">\n                <div class=\"ugp-stat\">\n                    <span class=\"ugp-stat__value\">200.000+</span>\n                    <span class=\"ugp-stat__label\">Supporters – entrepreneurs, craftspeople and private-sector employees</span>\n                </div>\n                <div class=\"ugp-stat\">\n                    <span class=\"ugp-stat__value\">20.100+</span>\n                    <span class=\"ugp-stat__label\">Members of the association</span>\n                </div>\n                <div class=\"ugp-stat\">\n                    <span class=\"ugp-stat__value\">5+ bn</span>\n                    <span class=\"ugp-stat__label\">EUR revenue of members and supporters</span>\n                </div>\n        </div>\n    </div>\n</header>"
                  }
                },
                "FlowMetadata": {
                  "Alignment": "Justify",
                  "Size": 100
                }
              },
              {
                "ContentItemId": "4ugphomeenmission000000000",
                "ContentType": "RawHtml",
                "DisplayText": "",
                "Latest": false,
                "Published": false,
                "RawHtml": {
                  "Content": {
                    "Html": "<section class=\"ugp-band ugp-mission\">\n    <div class=\"container px-4 px-lg-5\">\n        <div class=\"ugp-mission__grid\">\n            <div class=\"ugp-mission__intro\">\n                <p class=\"ugp-eyebrow\">Who we are</p>\n                <h2 class=\"ugp-title\">The voice of those who create value</h2>\n                <p class=\"ugp-muted\">We are entrepreneurs, craftspeople and self-employed people who create jobs and fill the state budget every day. We turn first-hand experience into proposals that decision-makers cannot ignore.</p>\n            </div>\n            <div class=\"ugp-stances\">\n                <p class=\"ugp-eyebrow\">What we stand for</p>\n                <ul class=\"ugp-stances__list\">\n                    <li><strong>Lower levies</strong><span>Abolishing parafiscal charges and mandatory membership fees</span></li>\n                    <li><strong>Clear and stable rules</strong><span>No more regulations changing overnight</span></li>\n                    <li><strong>A state that serves its citizens</strong><span>Accountable government and a better dialogue with entrepreneurs</span></li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</section>"
                  }
                },
                "FlowMetadata": {
                  "Alignment": "Justify",
                  "Size": 100
                }
              },
              {
                "ContentItemId": "4ugphomeenwork000000000000",
                "ContentType": "RawHtml",
                "DisplayText": "",
                "Latest": false,
                "Published": false,
                "RawHtml": {
                  "Content": {
                    "Html": "<section class=\"ugp-band ugp-work\" id=\"what-we-do\">\n    <div class=\"container px-4 px-lg-5\">\n        <p class=\"ugp-eyebrow\">What we do</p>\n        <h2 class=\"ugp-title\">For entrepreneurs on every front</h2>\n        <p class=\"ugp-work__lead\">Wherever decisions about entrepreneurs are made – we are there.</p>\n        <div class=\"ugp-work__grid\">\n            <article class=\"ugp-work__card\">\n                <img class=\"ugp-work__img\" src=\"/UgpTheme/assets/img/home/pred-vladom.jpg\" alt=\"Press statement in front of the Government on St. Mark's Square\" loading=\"lazy\">\n                <div class=\"ugp-work__body\">\n                    <h3 class=\"ugp-work__title\">Proposals to the Government</h3>\n                    <p class=\"ugp-work__text\">We present concrete measures and reforms publicly and hand them to those who make the decisions.</p>\n                </div>\n            </article>\n            <article class=\"ugp-work__card\">\n                <img class=\"ugp-work__img\" src=\"/UgpTheme/assets/img/home/prosvjed-zrinjevac.jpg\" alt=\"Protest stage on Zrinjevac with the message For a better dialogue with the state\" loading=\"lazy\">\n                <div class=\"ugp-work__body\">\n                    <h3 class=\"ugp-work__title\">“Enough with the levies!” protest</h3>\n                    <p class=\"ugp-work__text\">On 10 October 2026, together with other associations, we gathered in Zagreb’s Zrinjevac park to demand lower levies and a better dialogue with the state.</p>\n                </div>\n            </article>\n            <article class=\"ugp-work__card\">\n                <img class=\"ugp-work__img\" src=\"/UgpTheme/assets/img/home/konferencija.jpg\" alt=\"Panel at the 3rd Family Business Conference\" loading=\"lazy\">\n                <div class=\"ugp-work__body\">\n                    <h3 class=\"ugp-work__title\">Conferences and education</h3>\n                    <p class=\"ugp-work__text\">We bring together entrepreneurs and experts – from the Family Business Conference to “AI pogon za biznis” in Rijeka and Zagreb.</p>\n                </div>\n            </article>\n        </div>\n    </div>\n</section>"
                  }
                },
                "FlowMetadata": {
                  "Alignment": "Justify",
                  "Size": 100
                }
              },
