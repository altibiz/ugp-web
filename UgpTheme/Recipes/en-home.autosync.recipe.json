                    "Html": "<section class=\"ugp-band ugp-cta\">\n    <div class=\"container px-4 px-lg-5\">\n        <div class=\"ugp-cta__inner\">\n            <div>\n                <h2 class=\"ugp-cta__title\">Be part of the voice that drives change</h2>\n                <p class=\"ugp-cta__text\">The more of us there are, the louder we are heard. Join thousands of entrepreneurs who are already changing the rules of the game.</p>\n            </div>\n            <a class=\"ugp-btn ugp-btn--primary\" href=\"/register\">Become a member</a>\n        </div>\n    </div>\n</section>"
